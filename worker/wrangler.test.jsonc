{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "touchdown-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../web/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomHub" }]
  },
  "exports": {
    "RoomHub": { "type": "durable-object", "storage": "sqlite" }
  }
}
